<?xml version="1.0" encoding="UTF-8"?>
<impedanceFormat version="1">
  <description>Z-MFLI (Z_MFLI_datafile_example_template.xml)</description>
  <table delimiter="tab" decimalSeparator="auto" commentPrefix="" missingValues="NA;NaN;N/A"/>
  <datasets mode="repeatedHeader">
    <header match="contains">Temp /K before measurement : </header>
    <label source="afterHeader" length="6"/>
    <endMarker></endMarker>
    <skipLines afterHeader="4" beforeEnd="4" footerPolicy="keepNumeric"/>
  </datasets>
  <columns numbering="1" representation="cartesian">
    <frequency column="1" unit="Hz"/>
    <real column="2" unit="ohm"/>
    <imaginary column="3" unit="ohm" sign="Zi"/>
  </columns>
  <invalidRows action="skipAndReport"/>
</impedanceFormat>
